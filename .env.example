# BanglaHQ — environment variables
# Copy this file to .env (which is gitignored) and fill in the real values.
# Get these from your Supabase project settings → API.

# Supabase project URL, e.g. https://abc123.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key (starts with eyJ...)
# Also read as SUPABASE_PUBLISHABLE_KEY if VITE_ prefix is omitted.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Port the prerender script uses to connect to `vite preview` (default 4173).
# Also read as VITE_PREVIEW_PORT.
VITE_PREVIEW_PORT=4173

# NOTE: VITE_* variables are inlined into the client bundle and are public.
# Do NOT put server-side secrets (service-role key, webhook secrets) here.
# The VITE_PREVIEW_URL env var (not in .env) can point the prerender script at
# an already-running preview server instead of starting its own.
